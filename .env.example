# Required for real AI-powered resume parsing/tailoring. Set ONE of the two keys below.
# Add these as secrets in the Cursor Dashboard (Cloud Agents -> Secrets) for cloud runs,
# or in a local .env.local file for local development.
# If ANTHROPIC_API_KEY is set, Claude is used; otherwise OPENAI_API_KEY is used as a
# fallback. If neither is set (and MOCK_LLM isn't "1"), the app runs in mock mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the models used for parsing/tailoring.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_MODEL=gpt-4o-mini

# Optional: set to "1" to bypass the OpenAI API entirely and use deterministic mock
# data for resume parsing/tailoring. Useful for developing/testing the UI and
# PDF/DOCX export pipeline without an API key.
MOCK_LLM=
