# Required for real AI-powered resume parsing/tailoring.
# Add this as a secret in the Cursor Dashboard (Cloud Agents -> Secrets) for cloud runs,
# or in a local .env.local file for local development.
OPENAI_API_KEY=

# Optional: override the OpenAI model used for parsing/tailoring (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Optional: set to "1" to bypass the OpenAI API entirely and use deterministic mock
# data for resume parsing/tailoring. Useful for developing/testing the UI and
# PDF/DOCX export pipeline without an API key.
MOCK_LLM=
