# Required for real AI-powered resume parsing/tailoring: add ONE of the two keys below
# (Anthropic is preferred/used first if both are set — see LLM_PROVIDER to force one).
# Add these as secrets in the Cursor Dashboard (Cloud Agents -> Secrets) for cloud runs,
# or in a local .env.local file for local development.

# Preferred provider: Claude Sonnet 5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Adaptive-thinking effort Claude uses for parsing/tailoring: low | medium | high | xhigh.
ANTHROPIC_EFFORT=medium

# Fallback provider, used only if ANTHROPIC_API_KEY isn't set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: force a specific provider ("anthropic" or "openai") instead of the
# auto-detect-by-which-key-is-set behavior above.
LLM_PROVIDER=

# Optional: set to "1" to bypass real AI calls entirely and use deterministic mock
# data for resume parsing/tailoring. Useful for developing/testing the UI and
# PDF/DOCX export pipeline without an API key. Note: with this on, the app will
# ALWAYS return the same sample resume regardless of what you upload/paste — if
# your results don't reflect your actual input, check this isn't set to "1" and
# that a real API key above is configured.
MOCK_LLM=
