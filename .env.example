# Required for real AI-powered resume parsing/tailoring: add ONE of the two keys below
# (Anthropic is preferred/used first if both are set — see LLM_PROVIDER to force one).
# Add these as secrets in the Cursor Dashboard (Cloud Agents -> Secrets) for cloud runs,
# in a local .env.local file for local development, or in Vercel Project → Settings →
# Environment Variables for production AI.
#
# Never put these keys in NEXT_PUBLIC_* vars or commit them — GitHub Pages cannot keep
# secrets; the browser would expose them.

# Preferred provider: Claude Sonnet 5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Adaptive-thinking effort Claude uses for parsing/tailoring: low | medium | high | xhigh.
ANTHROPIC_EFFORT=medium

# Fallback provider, used only if ANTHROPIC_API_KEY isn't set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: force a specific provider ("anthropic" or "openai") instead of the
# auto-detect-by-which-key-is-set behavior above.
LLM_PROVIDER=

# --- Optional: browser UI on another origin → this Node host's /api ---
# github.io redirects to Vercel by default (see github-pages/index.html), so you
# usually do not need these. If you host the static UI elsewhere and call this
# app's API routes, set:
#   NEXT_PUBLIC_API_ORIGIN=https://anderfy.vercel.app
#   CORS_ALLOWED_ORIGINS=https://that-ui-origin.example,http://localhost:3000
NEXT_PUBLIC_API_ORIGIN=
CORS_ALLOWED_ORIGINS=

# Optional: set to "1" to bypass real AI calls entirely and use the free local
# heuristic parser/tailor (lib/heuristicResume.ts) over the resume + job posting
# you actually provide — no canned placeholder resume. Useful for developing/testing
# the UI and PDF/DOCX export pipeline without an API key. lib/llm.ts also falls back
# to this mode automatically if neither ANTHROPIC_API_KEY nor OPENAI_API_KEY is set.
MOCK_LLM=
